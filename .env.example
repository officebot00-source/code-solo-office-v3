# Project Reborn — environment variables. NEVER commit real values. Set them in:
#   Netlify -> Site configuration -> Environment variables   (scope: Builds + Functions + Runtime)
# After changing a variable: Deploys -> Trigger deploy -> Clear cache and deploy site.

# ── A. ALWAYS (both modes) ───────────────────────────────────────────────────
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable / anon key>
# set in netlify.toml already (do not set again): NITRO_PRESET, NODE_VERSION, VITE_DEPLOY_TARGET

# ── MODE A: "proxy" (Netlify = UI only, Lovable site answers the API) ────────
# VITE_BOT_API_BASE is in netlify.toml. Nothing else is required.
# Do NOT set ACTIVE_DEPLOYMENT_URL / CRON_SECRET / NETLIFY_CRON_ENABLED on Netlify in this mode.

# ── B. MODE B: "standalone" (Netlify runs API + cron + webhook; needs YOUR OWN Supabase) ──
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<same publishable key as above>
SUPABASE_SERVICE_ROLE_KEY=<service role key — secret, server only>
APP_PASSCODE=<the shared app password — long, not guessable>

# Duplicate-run guard (all three are needed for the cron to run):
ACTIVE_DEPLOYMENT_URL=https://<your-site>.netlify.app      # the ONE deployment allowed to run jobs (comma-separate if you also use a custom domain)
CRON_SECRET=<long random string>                           # e.g. `openssl rand -hex 32`
NETLIFY_CRON_ENABLED=true                                  # opt-in switch for netlify/functions/cron-tick.mts
# Emergency stop without code change: BOT_JOBS_ENABLED=false (jobs skip, UI keeps working)

# Facebook real-time comment bot (only if you use it; register the Netlify URL at Meta, see guide):
FB_APP_SECRET=
FB_VERIFY_TOKEN=

# Optional features:
LOVABLE_API_KEY=            # AI Caption writer uses Lovable AI Gateway (workspace credits)
PUBLIC_APP_URL=https://<your-site>.netlify.app
VIDEO_EDITOR_API_URL=       # https://<video-service>/edit  — REQUIRED for game videos on Netlify (no ffmpeg there). Deploy video-editor-service/ via render.yaml; steps: docs/video-service-deploy.md
VIDEO_EDITOR_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
# AI keys (OPENROUTER_API_KEY / OPENAI_API_KEY / GEMINI_API_KEY) are normally saved from the app's API Settings screen.
# Not used on Netlify: FFMPEG_PATH, VIDEO_MEDIA_DIR, VIDEO_FONT_FILE (no ffmpeg / persistent disk there).

# ── If the code is ALSO published on Lovable ─────────────────────────────────
# Lovable Secrets: ACTIVE_DEPLOYMENT_URL must be the SAME value as on Netlify. Then the Lovable copy answers
# "skipped" to its own schedule and webhook instead of running them a second time.
